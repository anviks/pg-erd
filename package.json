{
  "name": "@anviks/pg-erd",
  "version": "0.3.1",
  "description": "Headless PostgreSQL ERD renderer: schema to PNG/SVG, laid out with ELK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anviks/pg-erd.git"
  },
  "homepage": "https://github.com/anviks/pg-erd#readme",
  "bugs": {
    "url": "https://github.com/anviks/pg-erd/issues"
  },
  "author": "Andreas Viks",
  "keywords": [
    "postgresql",
    "postgres",
    "erd",
    "entity-relationship",
    "diagram",
    "schema",
    "svg",
    "png",
    "elk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "pg-erd": "bin/pg-erd.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "resources",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:it": "RUN_IT=1 vitest run test/integration",
    "lint": "tsc -p tsconfig.json --noEmit",
    "erd": "node bin/pg-erd.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "commander": "^13.1.0",
    "elkjs": "^0.12.0",
    "opentype.js": "^1.3.4",
    "pg": "^8.16.3",
    "pg-connection-string": "^2.14.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.0.0",
    "@types/node": "^22.15.0",
    "@types/opentype.js": "^1.3.8",
    "@types/pg": "^8.15.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
